# --- Jev backend (TypeSafe AI) — required ---
# TYPESAFE_API_KEY=ts-...
# JEV_MODEL=jev-1.13.0

# --- Cloud Run adapter limits (the engineering boundary) ---
# MAX_CONCURRENCY=8
# BATCH_SIZE=16
# MAX_RETRIES=3

# --- Circuit breaker thresholds ---
# DRIFT_THRESHOLD=0.15
# QUALITY_FLOOR=0.70
# SAMPLE_RATE=1.0
