# Backend auto-selects: jev (if TYPESAFE_API_KEY) > claude (if ANTHROPIC_API_KEY) > mock.
# Override explicitly:
# JEV_BACKEND=mock          # jev | claude | mock

# --- Claude backend (default when this is set) ---
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5

# --- Real Jev backend (TypeSafe AI) ---
# TYPESAFE_API_KEY=ts-...
# JEV_MODEL=jev-1.13.0

# --- Cloud Run adapter limits (the engineering boundary) ---
# MAX_CONCURRENCY=8
# BATCH_SIZE=16
# MAX_RETRIES=3

# --- Circuit breaker thresholds ---
# DRIFT_THRESHOLD=0.15
# QUALITY_FLOOR=0.70
# SAMPLE_RATE=1.0
